# Copy to .env and fill in. Never commit .env or credentials.
ANTHROPIC_API_KEY=
# Keep zero until a written chat run allocation is approved in Lenard's STATUS.
# The in-memory process budget resets on restart; the key alone enables no calls.
TYB_CHAT_BUDGET_USD=0
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_NAVIGATOR=
ELEVENLABS_AGENT_ID_ADMIN=
STATE_DIR=./.state
TYB_PROFILE=kit_1_1_0
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data
# Enable only for the rehearsed demo reset endpoint.
TYB_DEMO_MODE=false
# Admin sessions need this code in X-Admin-Token. Empty: nobody can open an admin session.
TYB_ADMIN_TOKEN=
# Local development only, never on a reachable server: 1 lets any client open an admin session without a code.
TYB_ADMIN_OPEN_INSECURE=
