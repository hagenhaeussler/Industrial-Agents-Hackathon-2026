# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Agent settings. Defaults shown; see docs/agent.md.
BUILDING_AGENT_MODEL=anthropic:claude-sonnet-5-5
BUILDING_AGENT_EFFORT=medium
BUILDING_AGENT_COST_LIMIT_USD=1.00
BUILDING_AGENT_REQUEST_LIMIT=60

# ElevenLabs voice agent. See docs/voice.md.
ELEVENLABS_API_KEY=
# Printed by `uv run python -m voice_agent sync` when it creates the agent.
ELEVENLABS_AGENT_ID=
# Bearer token ElevenLabs sends to the MCP endpoint. Generate with `openssl rand -hex 32`.
BUILDING_MCP_TOKEN=
# Comma-separated UI origins on other domains, such as https://ui.example.com. Empty: same origin or proxy only.
VOICE_CORS_ORIGINS=

# Explicit phone photo requests: Claude vision + the ElevenLabs agent's voice. Keys remain server-side.
# Set ANTHROPIC_API_KEY on the voice-agent service as well as ELEVENLABS_API_KEY above.
PHOTO_MODEL=claude-sonnet-5-5
# Optional override; empty uses the existing agent's voice.
PHOTO_VOICE_ID=
# Per-process UTC daily attempt limit, including provider failures. Restarts reset the counter.
PHOTO_DAILY_LIMIT=10
