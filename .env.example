# Copy to .env and fill in. Never commit .env or credentials.
ANTHROPIC_API_KEY=
# Keep zero until a written chat run allocation is approved in Lenard's STATUS.
# The in-memory process budget resets on restart; the key alone enables no calls.
TYB_CHAT_BUDGET_USD=0
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_NAVIGATOR=
ELEVENLABS_AGENT_ID_ADMIN=
STATE_DIR=./.state
TYB_PROFILE=kit_1_1_0
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data
# Private server value; send as X-Admin-Token only when creating an admin session.
# Use a long random value in production. Never set a VITE_ variable for this.
TYB_ADMIN_TOKEN=
# Enables the rehearsed demo reset endpoint; it does not grant admin access alone.
TYB_DEMO_MODE=false
# Isolated local demos only: no-code admin additionally requires both this and demo mode.
# A configured admin token remains mandatory regardless of either demo flag.
TYB_ALLOW_UNAUTHENTICATED_DEMO_ADMIN=false
