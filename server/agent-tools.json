[
  {
    "description": "Discover this building's floors, entity types, counts and current session constraints.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "title": "InfoArgs",
      "type": "object"
    },
    "name": "building_info",
    "roles": [
      "admin",
      "navigator"
    ]
  },
  {
    "description": "List and filter building objects with complete paginated results. Use real types and IDs from building_info.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "floor_id": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Id"
        },
        "kind": {
          "default": "asset",
          "enum": [
            "asset",
            "space",
            "floor",
            "connector",
            "opening"
          ],
          "title": "Kind",
          "type": "string"
        },
        "limit": {
          "default": 25,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "query": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        },
        "space_id": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Space Id"
        },
        "type": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact asset type or room type, for asset or space searches.",
          "title": "Type"
        }
      },
      "title": "SearchArgs",
      "type": "object"
    },
    "name": "search_entities",
    "roles": [
      "admin",
      "navigator"
    ]
  },
  {
    "description": "Fetch details for stable entity IDs. Unknown IDs fail explicitly.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "ids": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Ids",
          "type": "array"
        }
      },
      "required": [
        "ids"
      ],
      "title": "GetEntitiesArgs",
      "type": "object"
    },
    "name": "get_entities",
    "roles": [
      "admin",
      "navigator"
    ]
  },
  {
    "description": "Compare actual routes to candidate IDs under mobility constraints. Returns the nearest reachable destination and unreachable reasons without changing navigation.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Closed",
          "type": "array"
        },
        "destination_ids": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Destination Ids",
          "type": "array"
        },
        "min_door_width_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Door Width M"
        },
        "start": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "step_free": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Free"
        }
      },
      "required": [
        "destination_ids"
      ],
      "title": "CompareRoutesArgs",
      "type": "object"
    },
    "name": "compare_routes",
    "roles": [
      "admin",
      "navigator"
    ]
  },
  {
