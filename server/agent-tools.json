  {
    "description": "Compute areas, counts, asset locations, adjacency, 3D distances, reachability or a hypothetical door. Use IDs and types from discovery. Temporary closures do not save edits.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "asset_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Type"
        },
        "closed": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Closed",
          "type": "array"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "above",
                "below"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "floor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor"
        },
        "kind": {
          "enum": [
            "largest_room",
            "floor_area_total",
            "errand",
            "wide_delivery_count",
            "step_free_reachable_count",
            "room_stacked",
            "shared_walls_count",
            "straight_line_3d",
            "what_if_door",
            "count",
            "locate"
          ],
          "title": "Kind",
          "type": "string"
        },
        "min_width_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Width M"
        },
        "room_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Type"
        },
        "second_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For step_free_reachable_count, an optional additional connector, door or room to close. With no current or requested closures, count the unmodified building. For other kinds, the second comparison target.",
          "title": "Second Target"
        },
        "step_free": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Free"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "kind"
      ],
      "title": "SpatialArgs",
      "type": "object"
    },
    "name": "spatial_query",
    "roles": [
      "admin",
      "navigator"
    ]
  },
