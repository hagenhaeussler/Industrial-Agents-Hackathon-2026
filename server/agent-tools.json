          "type": "array"
        },
        "destination": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Destination",
          "type": "string"
        },
        "min_door_width_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Door Width M"
        },
        "start": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "step_free": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Free"
        }
      },
      "required": [
        "destination"
      ],
      "title": "RouteQueryArgs",
      "type": "object"
    },
    "name": "query_route",
    "roles": [
      "admin",
      "navigator"
    ]
  },
